{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",              // change this
    "moduleResolution": "node",    // keep this
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "sourceMap": true
  }
}
