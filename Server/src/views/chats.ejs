<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Chat Room</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", sans-serif;
    }

    body {
      height: 100vh;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .chat-container {
      width: 420px;
      height: 600px;
      background: #020617;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* HEADER */
    .chat-header {
      display: flex;
      align-items: center;
      padding: 12px;
      gap: 10px;
      background: #020617;
      border-bottom: 1px solid #1e293b;
    }

    /* 🔙 BACK BUTTON (VISIBLE AF) */
    .back-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: none;
      background: #6366f1;   /* 👈 bright */
      color: #fff;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .back-btn:hover {
      background: #4f46e5;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: bold;
    }

    .user-info h3 {
      color: #f8fafc;
      font-size: 16px;
    }

    .user-info span {
      font-size: 12px;
      color: #22c55e;
    }

    /* MESSAGES */
    .chat-body {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .message {
      max-width: 75%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 14px;
    }

    .incoming {
      background: #1e293b;
      color: #e5e7eb;
      align-self: flex-start;
    }

    .outgoing {
      background: #6366f1;
      color: #fff;
      align-self: flex-end;
    }

    .time {
      font-size: 10px;
      opacity: 0.7;
      margin-top: 4px;
    }

    /* INPUT */
    .chat-footer {
      display: flex;
      padding: 12px;
      border-top: 1px solid #1e293b;
    }

    .chat-footer input {
      flex: 1;
      padding: 10px;
      border-radius: 8px;
      border: none;
      background: #1e293b;
      color: #fff;
      outline: none;
    }

    .chat-footer button {
      margin-left: 8px;
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      background: #6366f1;
      color: #fff;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <div class="chat-container">

    <!-- HEADER -->
    <div class="chat-header">
      <div class="back-btn" onclick="handleBack()">←</div>

      <div class="avatar">U</div>

      <div class="user-info">
        <h3>Other User</h3>
        <span>Online</span>
      </div>
    </div>

    <!-- BODY -->
    <div class="chat-body">
      <div class="message incoming">
        Hey 👋
        <div class="time">10:01 AM</div>
      </div>

      <div class="message outgoing">
        Hello! How are you?
        <div class="time">10:02 AM</div>
      </div>
    </div>

    <!-- INPUT -->
    <form class="chat-footer">
      <input type="text" placeholder="Type a message..." />
      <button>Send</button>
    </form>

  </div>
</body>

  <script src="/socket.io/socket.io.js"></script>        
  <script>
    const socket = io();

    const handleBack = () => {
      socket.emit('leave-room', room_id = '695e9b2a6729b6e66b60f52a');
      window.location.href = "http://localhost:5000/welcome";
    };

    socket.on('connect', () => {
      console.log("✅ socket connected:", socket.id);

      socket.emit('join-room', room_id = '695e9b2a6729b6e66b60f52a');

    });
  </script>

</html>
