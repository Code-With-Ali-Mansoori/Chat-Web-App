<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Chat Room</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", sans-serif;
    }

    body {
      height: 100vh;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .chat-container {
      width: 420px;
      height: 600px;
      background: #020617;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* HEADER */
    .chat-header {
      display: flex;
      align-items: center;
      padding: 12px;
      gap: 10px;
      background: #020617;
      border-bottom: 1px solid #1e293b;
    }

    /* 🔙 BACK BUTTON (VISIBLE AF) */
    .back-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: none;
      background: #6366f1;   /* 👈 bright */
      color: #fff;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .back-btn:hover {
      background: #4f46e5;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: bold;
    }

    .user-info h3 {
      color: #f8fafc;
      font-size: 16px;
    }

    .user-info span {
      font-size: 12px;
      color: #22c55e;
    }

    /* MESSAGES */
    .chat-body {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .message {
      max-width: 75%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 14px;
    }

    .incoming {
      background: #1e293b;
      color: #e5e7eb;
      align-self: flex-start;
    }

    .outgoing {
      background: #6366f1;
      color: #fff;
      align-self: flex-end;
    }

    .time {
      font-size: 10px;
      opacity: 0.7;
      margin-top: 4px;
    }

    /* INPUT */
    .chat-footer {
      display: flex;
      padding: 12px;
      border-top: 1px solid #1e293b;
    }

    .chat-footer input {
      flex: 1;
      padding: 10px;
      border-radius: 8px;
      border: none;
      background: #1e293b;
      color: #fff;
      outline: none;
    }

    .chat-footer button {
      margin-left: 8px;
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      background: #6366f1;
      color: #fff;
      cursor: pointer;
    }

    .type-text {
      text-align: left;
      padding: 8px;
      color: rgb(205, 205, 205);
      background-color: #1e293b;
      border-radius: 8px;
      font-size: small;
      margin-block: 4px;
      display: none;
    }

  </style>
</head>

<body>

  <div class="chat-container">

    <!-- HEADER -->
    <div class="chat-header">
      <div class="back-btn" onclick="handleBack()">←</div>

      <div class="avatar">U</div>

      <div class="user-info">
        <h3>Other User</h3>
        <span>Online</span>
      </div>
    </div>

    <!-- BODY -->
    <div class="chat-body">

      <div class="message incoming">
          msg
        <div class="time">10:01 AM</div>
      </div>      

      <div class="message outgoing">
        Hello! How are you?
        <div class="time">10:02 AM</div>
      </div>

      <div class="type-indicator">
        <span class="type-text">Typing...</span>
      </div>
    
    </div>

    <!-- INPUT -->
    <form onsubmit="handleSocketMsg(event)" class="chat-footer">
      <input oninput="handleInputMsg()" id="msg-Input" type="text" placeholder="Type a message..." />
      <button type="submit">Send</button>
    </form>

  </div>
</body>

  <script src="/socket.io/socket.io.js"></script>        
  <script>

    const socket = io();
    let user_TypesMsg;
    let All_msgs = [];
    
    socket.on('connect', () => {
      console.log("✅ socket connected:", socket.id);

      //Setting Manually for Testign logic
      socket.emit('join-room', room_id = '695e9b2a6729b6e66b60f52a');   

      socket.on('msg_seen', (UserName) => {
        console.log(`Msg Seen by this user => ${UserName}`);
      });

      socket.on('users-typing', () => {
        const textIndicator = document.querySelector('.type-text');
        if (!textIndicator) return;
        
        textIndicator.style.display="inline";
      });

      socket.on('stop-typinggggg', () => {
        const textIndicator = document.querySelector('.type-text');
        if (!textIndicator) return;
        
        textIndicator.style.display="none";
      });

      socket.on('receive-msg', (msg) => {
          console.log(msg);

        //Frontend pe me apne user_data ko sender_Id se match karaunga, 
        // agar wo same hoga to msg ko [ Right side ] me align kardunga, 
        // nahi to samjhunga wo samne wale ka msg h to [ left side ] me align kar dunga!
      })

    });

    const handleBack = () => {
      //Setting Manually for Testign logic
      socket.emit('leave-room', room_id = '695e9b2a6729b6e66b60f52a');  
      window.location.href = "http://localhost:5000/welcome";
    };

    const handleInputMsg = () => {     
        let typingTimeout;

        //Setting Manually for Testign logic
        socket.emit('typing', room_id = '695e9b2a6729b6e66b60f52a');
        clearTimeout(typingTimeout);

        //Setting Manually for Testign logic
        typingTimeout = setTimeout(() => {
          socket.emit('stop-typing' , room_id = '695e9b2a6729b6e66b60f52a');

        },1000);
    };

    const handleSocketMsg = (e) => {
      e.preventDefault();

      const inputFeild = document.querySelector('#msg-Input');
      const inputMsg = inputFeild.value;

      //Setting Manually for Testign logic
      socket.emit('send-message', {
        msg : inputMsg,
        msg_type : 'text',
        sender_id : "695de922c4f2d3af9ea623cf",   //Get from the Client through API
        room_id : '695e9b2a6729b6e66b60f52a'    //Get from the Client through API
      }); 

      inputFeild.value= "";
    };

  </script>

</html>
