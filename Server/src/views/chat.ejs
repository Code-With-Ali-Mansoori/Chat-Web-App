<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Chat Room</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", sans-serif;
    }

    body {
      height: 100vh;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .chat-container {
      width: 420px;
      height: 600px;
      background: #020617;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      overflow: hidden;
    }

    /* Header */
    .chat-header {
      background: #020617;
      padding: 15px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid #1e293b;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: bold;
      margin-right: 10px;
    }

    .user-info h3 {
      color: #f8fafc;
      font-size: 16px;
    }

    .user-info span {
      font-size: 12px;
      color: #22c55e;
    }

    /* Messages */
    .chat-body {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .message {
      max-width: 75%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 14px;
      line-height: 1.4;
    }

    .incoming {
      background: #1e293b;
      color: #e5e7eb;
      align-self: flex-start;
      border-bottom-left-radius: 0;
    }

    .outgoing {
      background: #6366f1;
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 0;
    }

    .time {
      font-size: 10px;
      opacity: 0.7;
      margin-top: 4px;
    }

    /* Input */
    .chat-footer {
      display: flex;
      padding: 12px;
      border-top: 1px solid #1e293b;
      background: #020617;
    }

    .chat-footer input {
      flex: 1;
      padding: 10px;
      border-radius: 8px;
      border: none;
      outline: none;
      background: #1e293b;
      color: #fff;
    }

    .chat-footer button {
      margin-left: 8px;
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      background: #6366f1;
      color: #fff;
      cursor: pointer;
      font-weight: 600;
    }

    .chat-footer button:hover {
      background: #4f46e5;
    }
  </style>
</head>

<body>

  <div class="chat-container">

    <!-- Header -->
    <div class="chat-header">
      <div class="avatar">U</div>
      <div class="user-info">
        <h3>Other User</h3>
        <span>Online</span>
      </div>
    </div>

    <!-- Messages -->
    <div class="chat-body" id="chatBody">
      <div class="message incoming">
        Hey 👋
        <div class="time">10:01 AM</div>
      </div>

      <div class="message outgoing">
        Hello! How are you?
        <div class="time">10:02 AM</div>
      </div>
    </div>

    <!-- Input -->
    <form class="chat-footer" id="chatForm">
      <input
        type="text"
        id="messageInput"
        placeholder="Type a message..."
        autocomplete="off"
      />
      <button type="submit">Send</button>
    </form>

  </div>

  <!-- Socket.IO -->
  <script src="/socket.io/socket.io.js"></script>
  
  <script>
    const socket = io();
  </script>

</body>
</html>
